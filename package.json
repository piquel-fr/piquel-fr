{
  "name": "piquel-fr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check": "tsc && tsc -p apps/auth-service/assets && tsc -p packages/auth --noEmit && tsc -p packages/auth/test && tsc -p packages/auth/examples",
    "lint": "eslint --max-warnings 0 . && pnpm --filter @piquel/auth lint",
    "test": "pnpm --filter @piquel/auth test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
