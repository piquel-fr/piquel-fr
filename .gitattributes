# Generated files, which GitHub collapses in diffs and leaves out of language
# statistics. CI fails while any of them is missing or out of date. Linguist
# already knows Cargo.lock and pnpm-lock.yaml.

# SQLx's query cache, written by `just db prepare`. `just db prepare-check` fails
# unless it holds exactly the queries the code uses, with no leftover files.
crates/database/.sqlx/** linguist-generated
# The SDK test vectors, written by `just sdk-vectors`; the keys and README are not.
tests/sdk-vectors/**/*.json linguist-generated
# The TypeScript SDK's wire types, written by `just sdk-types`.
packages/auth/src/protocol.ts linguist-generated
# The CLI and configuration references, written by `just docs reference`.
docs/dev/operations/cli-commands.md linguist-generated
docs/dev/operations/variables/*.md linguist-generated
# The documentation's screenshots, retaken by `just docs screenshots`.
docs/images/** linguist-generated
