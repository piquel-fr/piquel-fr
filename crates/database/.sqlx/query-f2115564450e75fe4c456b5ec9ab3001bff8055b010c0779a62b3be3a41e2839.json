  "query": "SELECT id AS \"id: AlertId\", payload, version, raised_at, seen_at,\n                    acknowledged_at, cleared_at\n                FROM alerts\n                WHERE (cleared_at IS NOT NULL) = $1\n                ORDER BY coalesce(cleared_at, raised_at) DESC, id DESC\n                LIMIT $2",
