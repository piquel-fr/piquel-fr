{
  "db_name": "PostgreSQL",
  "query": "SELECT id AS \"id: NotificationId\", event_id AS \"event_id: EventId\",\n                    payload, created_at, read_at\n                FROM notifications\n                WHERE user_id = $1 AND read_at IS NULL\n                    AND NOT (payload ->> 'kind' = ANY($2))\n                ORDER BY created_at DESC, id DESC\n                LIMIT $3",
