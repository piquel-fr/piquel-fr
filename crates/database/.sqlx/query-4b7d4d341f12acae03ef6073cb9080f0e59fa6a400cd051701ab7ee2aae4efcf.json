{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                    id AS \"id: SessionId\",\n                    authentication_methods AS \"methods: JsonArray<AuthenticationMethod>\",\n                    authenticated_at, passkey_confirmed_at, last_seen_at, expires_at\n                FROM sessions\n                WHERE user_id = $1\n                AND revoked_at IS NULL\n                AND expires_at > now()\n                ORDER BY authenticated_at DESC",
