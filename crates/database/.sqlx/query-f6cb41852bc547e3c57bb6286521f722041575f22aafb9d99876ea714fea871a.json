  "query": "SELECT d.session_id AS \"session_id: SessionId\", d.created_at AS signed_in_at,\n                    d.last_used_at, d.expires_at\n                FROM dashboard_sessions d\n                JOIN sessions s ON s.id = d.session_id\n                WHERE s.user_id = $1\n                ORDER BY d.created_at DESC",
