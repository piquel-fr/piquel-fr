  "query": "SELECT\n                    a.user_id AS \"user_id: UserId\", u.username, a.granted_at,\n                    a.granted_by AS \"granted_by: Json<Actor>\"\n                FROM administrators a\n                JOIN users u ON u.id = a.user_id\n                ORDER BY a.granted_at, a.user_id",
