  "query": "SELECT\n                    id AS \"id: PasskeyId\", credential_id, user_id AS \"user_id: UserId\", credential,\n                    friendly_name, revoked_at\n                FROM passkey_credentials\n                WHERE user_id = $1 AND revoked_at IS NULL AND created_at < $2\n                ORDER BY created_at, id",
