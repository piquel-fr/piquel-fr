{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                    u.id AS \"id: UserId\", h.handle AS \"handle: Handle\", u.display_name,\n                    u.status AS \"status: AccountStatus\", u.created_at\n                FROM users u\n                JOIN handles h ON h.user_id = u.id AND h.released_at IS NULL\n                ORDER BY u.created_at DESC, u.id DESC\n                LIMIT $1",
