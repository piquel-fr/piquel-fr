        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Actions by administrator",
      "id": 16,
      "description": "Events each administrator caused over the dashboard's range, by kind. Look the administrator up by ID in the admin dashboard.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "expr": "sum by (event_administrator, event_kind) (count_over_time({service_name=\"auth-service\", deployment_environment_name=~\"$environment\"} | event_kind != \"\" | event_administrator != \"\" [$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "event_administrator": "Administrator",
              "event_kind": "Event",
              "Value": "Count"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Administrative events",
      "id": 17,
      "description": "Every event an administrator or operator caused. Expand a line for its trace, subject and administrator; look the event up by ID in the admin dashboard's Events page.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"auth-service\", deployment_environment_name=~\"$environment\"} | event_kind != \"\" | event_actor=~\"admin|operator\" | line_format \"{{.event_kind}} by {{.event_actor}}{{with .event_administrator}} {{.}}{{end}}{{with .event_subject}}, on account {{.}}{{end}}\""
        }
      ]
    },
    {
      "type": "logs",
      "title": "Dashboard refusals",
      "id": 18,
      "description": "Every refused request of an administrator, with its reason. Expand a line to open its trace, which shows the route.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"auth-service\", deployment_environment_name=~\"$environment\"} | admin_failure != \"\" | line_format \"admin dashboard request refused: {{.admin_failure}}\""
        }
      ]
    },
    {
      "type": "table",
      "title": "Dashboard traces",
      "id": 20,
      "description": "Recent admin dashboard request traces; open one by its trace ID.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 50,
          "tableType": "traces",
          "query": "{resource.service.name=\"auth-service\" && resource.deployment.environment.name=~\"$environment\" && kind=server && span.piquel.listener=\"admin\"}"
        }
      ]
    }
  ]
}
