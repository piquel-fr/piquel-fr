            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum by (admin_failure) (count_over_time({service_name=\"auth-service\", deployment_environment_name=~\"$environment\"} | admin_failure != \"\" [$__auto]))",
          "legendFormat": "{{admin_failure}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dashboard requests",
      "description": "Admin dashboard requests per second, by method and route, reads included. Searches and event listings are not recorded as events, so a burst of reads shows only here.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"auth-service\", deployment_environment_name=~\"$environment\", piquel_listener=\"admin\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dashboard responses",
