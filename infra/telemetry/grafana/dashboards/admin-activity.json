    {
      "type": "timeseries",
      "title": "Administrator actions",
      "description": "Events administrators caused through the admin dashboard, by kind.",
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "sum by (event_kind) (count_over_time({service_name=\"auth-service\", deployment_environment_name=~\"$environment\"} | event_kind != \"\" | event_actor=\"admin\" [$__auto]))",
          "legendFormat": "{{event_kind}}"
        }
      ]
    },
