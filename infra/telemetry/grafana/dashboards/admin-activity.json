{
  "uid": "admin-activity",
  "title": "Admin activity",
  "description": "What administrators and operators did, and dashboard requests that were refused: to notice a stolen administrator session or a compromised server.",
  "tags": [
    "auth",
    "admin",
    "security"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{job=\"auth-service\"}, deployment_environment_name)",
          "refId": "environment"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{job=\"auth-service\"}, deployment_environment_name)",
        "current": {
          "text": "production",
          "value": "production"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "search",
        "label": "Log search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "Auth overview",
      "type": "link",
      "url": "/d/auth-overview/auth-overview?${environment:queryparam}",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "At a glance",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Administrator changes",
      "description": "Administrator rights granted or revoked, by an administrator or an operator. Each should be expected.",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"auth-service\", deployment_environment_name=~\"$environment\"} | event_kind != \"\" | event_kind=~\"administrator_granted|administrator_revoked\" [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Refused sign-ins",
      "description": "Dashboard requests and handoffs refused because the account is not an administrator, and handoff codes that did not work. The dashboard's own pages never cause them, so each one is worth explaining.",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
