          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"auth-service\", deployment_environment_name=~\"$environment\"} | admin_failure != \"\" | admin_failure=~\"not_administrator|invalid_handoff\" [$__range]))"
        }
      ]
    },
