          "expr": "label_replace(sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"auth-service\", deployment_environment_name=~\"$environment\"}[$__rate_interval])), \"http_route\", \"unmatched path\", \"http_route\", \"\")",
          "legendFormat": "{{http_route}}",
